{
  "expo": {
    "name": "ONE-OS",
    "slug": "one-os",
    "scheme": "oneos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ONE-OS uses selected photos only when you choose to share a private memory.",
          "cameraPermission": "ONE-OS uses the camera only when you choose to capture a private memory.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.vedansh.oneos",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111318"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
